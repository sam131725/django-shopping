# Base URL of the Django backend (app/urls.py mounts the API at /api/...)
#
# Use "localhost", not "127.0.0.1", for the backend too: browsers treat
# localhost:3000 and 127.0.0.1:8000 as different sites, so Django's default
# SameSite=Lax session cookie won't be sent cross-origin between them. Both
# hosts already run on the same port scheme, and Django's ALLOWED_HOSTS
# already lists "localhost", so run: python manage.py runserver localhost:8000
VITE_API_BASE_URL=http://localhost:8000
